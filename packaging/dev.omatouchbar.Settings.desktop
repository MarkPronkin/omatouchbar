[Desktop Entry]
Type=Application
Name=Touch Bar
GenericName=Touch Bar Settings
Comment=Configure omatouchbar, the Omarchy bar on the T1 Touch Bar
Exec=omatouchbar-settings
Icon=dev.omatouchbar.Settings
Terminal=false
NoDisplay=true
Categories=Settings;HardwareSettings;
Keywords=touchbar;touch bar;t1;macbook;omarchy;bar;
StartupNotify=true
StartupWMClass=dev.omatouchbar.Settings
